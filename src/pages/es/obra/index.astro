---
import Layout from '../../../layouts/Layout.astro';
import Gallery from '../../../components/Gallery.astro';
import { categories } from '../../../data/categories';
import { readdir } from 'fs/promises';

// Get all gallery images
const galleryDir = 'public/images/gallery';
const files = await readdir(galleryDir);

const allImages = files
  .filter(f => f.endsWith('.jpg') && !f.includes('├'))
  .sort()
  .map((filename) => {
    const name = filename.replace('.jpg', '').replace(/-1$/, '');
    return {
      src: `/images/gallery/${filename}`,
      alt: name,
      title: name.replace(/-/g, ' ')
    };
  });

// Categorías con sus datos
const categoryList = [
  { name: 'Grabado', slug: 'grabado', count: categories.grabado.length },
  { name: 'Dibujo', slug: 'dibujo', count: categories.dibujo.length },
  { name: 'Técnica Mixta', slug: 'tecnica-mixta', count: categories.tecnicaMixta.length },
  { name: 'Óleo', slug: 'oleo', count: categories.oleo.length },
  { name: 'Escultura', slug: 'escultura', count: categories.escultura.length },
  { name: 'Collage', slug: 'collage', count: categories.collage.length },
];
---

<Layout
	title="Obra de Miguel Zapata"
	lang="es"
	description="Galería completa de obras de Miguel Zapata. Grabados, óleos, esculturas y técnica mixta."
>
	<main class="min-h-screen">
		<!-- Header / Navigation -->
		<header class="bg-stone-900 text-white py-6 px-4 sticky top-0 z-40 shadow-lg">
			<div class="max-w-7xl mx-auto flex justify-between items-center">
				<h1 class="text-2xl md:text-3xl font-bold tracking-wide">Miguel Zapata</h1>
				<nav class="flex items-center gap-6">
					<a href="/es/" class="hover:text-amber-400 transition">Inicio</a>
					<a href="/es/biografia/" class="hover:text-amber-400 transition">Biografía</a>
					<a href="/es/obra/" class="hover:text-amber-400 transition font-semibold">Obra</a>
					<a href="/en/artwork/" class="px-4 py-2 bg-white/10 rounded hover:bg-white/20 transition text-sm">EN</a>
				</nav>
			</div>
		</header>

		<!-- Page Header -->
		<section class="bg-gradient-to-br from-stone-800 to-stone-900 text-white py-16 px-4">
			<div class="max-w-7xl mx-auto text-center">
				<h2 class="text-4xl md:text-6xl font-bold mb-6">Obra</h2>
				<p class="text-xl text-stone-300 max-w-3xl mx-auto">
					Explora la colección de Miguel Zapata por categoría
				</p>
			</div>
		</section>

		<!-- Categories Grid -->
		<section class="max-w-7xl mx-auto py-16 px-4">
			<div class="grid grid-cols-2 md:grid-cols-3 gap-6">
				{categoryList.map((cat) => (
					<a
						href={`/es/obra/${cat.slug}/`}
						class="group relative bg-stone-800 rounded-lg overflow-hidden aspect-[4/3] flex items-center justify-center hover:scale-105 transition-transform duration-300"
					>
						<div class="text-center text-white z-10">
							<h3 class="text-2xl md:text-3xl font-bold mb-2 group-hover:text-amber-400 transition">{cat.name}</h3>
							<p class="text-stone-400">{cat.count} obras</p>
						</div>
						<div class="absolute inset-0 bg-gradient-to-t from-stone-900/80 to-stone-800/40"></div>
					</a>
				))}
			</div>
		</section>

		<!-- Full Gallery Section -->
		<section class="bg-stone-100 py-16 px-4">
			<div class="max-w-7xl mx-auto">
				<h3 class="text-3xl font-bold text-center mb-8">Galería Completa</h3>
				<p class="text-center text-stone-600 mb-12">
					{allImages.length} obras en total. Click en cualquier imagen para verla en detalle.
				</p>
				<Gallery images={allImages} columns={3} />
			</div>
		</section>

		<!-- Footer -->
		<footer class="bg-stone-900 text-white py-12 px-4">
			<div class="max-w-7xl mx-auto text-center">
				<p class="text-stone-400">&copy; {new Date().getFullYear()} Miguel Zapata. Todos los derechos reservados.</p>
				<p class="text-stone-500 mt-2 text-sm">Sitio creado en memoria del artista</p>
			</div>
		</footer>
	</main>
</Layout>
