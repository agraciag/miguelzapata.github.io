---
import Layout from '../../../layouts/Layout.astro';
import Gallery from '../../../components/Gallery.astro';

// Ejemplo de imágenes de la galería (placeholder con las imágenes del intro)
const sampleImages = [
	{
		src: '/intro/media/cuenca.jpg',
		alt: 'Puerta de Cuenca',
		title: 'Puerta de la Catedral de Cuenca'
	},
	{
		src: '/intro/media/texas.jpg',
		alt: 'Puerta de Texas',
		title: 'Texas Door - Meadows Museum'
	},
	{
		src: '/intro/media/toro1.jpg',
		alt: 'Toro',
		title: 'Toro - Serie Taurina'
	},
	{
		src: '/intro/media/woods.jpg',
		alt: 'Woods',
		title: 'Woods - Paisaje'
	},
	{
		src: '/intro/media/cuenca.jpg',
		alt: 'Cuenca 2',
		title: 'Catedral de Cuenca - Vista 2'
	},
	{
		src: '/intro/media/texas.jpg',
		alt: 'Texas 2',
		title: 'Detalle Puerta Texas'
	}
];
---

<Layout
	title="Obra de Miguel Zapata"
	lang="es"
	description="Galería completa de obras de Miguel Zapata. Grabados, óleos, esculturas y técnica mixta."
>
	<main class="min-h-screen">
		<!-- Header / Navigation -->
		<header class="bg-stone-900 text-white py-6 px-4 sticky top-0 z-40 shadow-lg">
			<div class="max-w-7xl mx-auto flex justify-between items-center">
				<h1 class="text-2xl md:text-3xl font-bold tracking-wide">Miguel Zapata</h1>
				<nav class="flex items-center gap-6">
					<a href="/es/" class="hover:text-amber-400 transition">Inicio</a>
					<a href="/es/biografia/" class="hover:text-amber-400 transition">Biografía</a>
					<a href="/es/obra/" class="hover:text-amber-400 transition font-semibold">Obra</a>
					<a href="/en/artwork/" class="px-4 py-2 bg-white/10 rounded hover:bg-white/20 transition text-sm">EN</a>
				</nav>
			</div>
		</header>

		<!-- Page Header -->
		<section class="bg-gradient-to-br from-stone-800 to-stone-900 text-white py-20 px-4">
			<div class="max-w-7xl mx-auto text-center">
				<h2 class="text-4xl md:text-6xl font-bold mb-6">Obra Completa</h2>
				<p class="text-xl text-stone-300 max-w-3xl mx-auto">
					Explorar la colección completa de obras de Miguel Zapata, organizadas por categoría.
					Click en cualquier imagen para verla en detalle.
				</p>
			</div>
		</section>

		<!-- Categories Navigation -->
		<section class="bg-stone-100 border-b border-stone-200">
			<div class="max-w-7xl mx-auto px-4 py-6">
				<nav class="flex flex-wrap gap-4 justify-center">
					<a href="/es/obra/" class="px-6 py-3 bg-amber-600 text-white rounded-lg font-semibold">Todas</a>
					<a href="/es/obra/grabado/" class="px-6 py-3 bg-white text-stone-700 rounded-lg hover:bg-stone-200 transition">Grabado</a>
					<a href="/es/obra/dibujo/" class="px-6 py-3 bg-white text-stone-700 rounded-lg hover:bg-stone-200 transition">Dibujo</a>
					<a href="/es/obra/tecnica-mixta/" class="px-6 py-3 bg-white text-stone-700 rounded-lg hover:bg-stone-200 transition">Técnica Mixta</a>
					<a href="/es/obra/oleo/" class="px-6 py-3 bg-white text-stone-700 rounded-lg hover:bg-stone-200 transition">Óleo</a>
					<a href="/es/obra/escultura/" class="px-6 py-3 bg-white text-stone-700 rounded-lg hover:bg-stone-200 transition">Escultura</a>
					<a href="/es/obra/collage/" class="px-6 py-3 bg-white text-stone-700 rounded-lg hover:bg-stone-200 transition">Collage</a>
				</nav>
			</div>
		</section>

		<!-- Gallery Section -->
		<section class="max-w-7xl mx-auto py-16 px-4">
			<div class="mb-12">
				<h3 class="text-3xl font-bold mb-4">Galería de Ejemplo</h3>
				<p class="text-stone-600">
					Esta es una demostración de la galería con lightbox modal.
					Las imágenes reales de las obras se migrarán desde WordPress.
				</p>
			</div>

			<Gallery images={sampleImages} columns={3} />
		</section>

		<!-- Instructions -->
		<section class="bg-stone-100 py-12 px-4">
			<div class="max-w-4xl mx-auto text-center">
				<h4 class="text-2xl font-bold mb-4">Instrucciones de Navegación</h4>
				<div class="grid md:grid-cols-3 gap-6 mt-8">
					<div class="bg-white p-6 rounded-lg shadow">
						<div class="text-4xl mb-3">🖱️</div>
						<h5 class="font-bold mb-2">Click en imagen</h5>
						<p class="text-sm text-stone-600">Abre la imagen en pantalla completa</p>
					</div>
					<div class="bg-white p-6 rounded-lg shadow">
						<div class="text-4xl mb-3">⌨️</div>
						<h5 class="font-bold mb-2">Teclas ← →</h5>
						<p class="text-sm text-stone-600">Navega entre imágenes</p>
					</div>
					<div class="bg-white p-6 rounded-lg shadow">
						<div class="text-4xl mb-3">✕</div>
						<h5 class="font-bold mb-2">ESC o X</h5>
						<p class="text-sm text-stone-600">Cierra la vista ampliada</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Footer -->
		<footer class="bg-stone-900 text-white py-12 px-4">
			<div class="max-w-7xl mx-auto text-center">
				<p class="text-stone-400">&copy; {new Date().getFullYear()} Miguel Zapata. Todos los derechos reservados.</p>
				<p class="text-stone-500 mt-2 text-sm">Sitio creado en memoria del artista</p>
			</div>
		</footer>
	</main>
</Layout>
