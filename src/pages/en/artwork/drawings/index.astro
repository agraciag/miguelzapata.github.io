---
import Layout from '../../../../layouts/Layout.astro';
import Gallery from '../../../../components/Gallery.astro';
import { categories } from '../../../../data/categories';

const categoryImages = categories.dibujo;
const images = categoryImages.map((filename) => ({
  src: `/images/gallery/${filename}`,
  alt: filename.replace('.jpg', '').replace(/-1$/, ''),
  title: filename.replace('.jpg', '').replace(/-1$/, '').replace(/-/g, ' ')
}));
---

<Layout title="Drawings - Miguel Zapata" lang="en">
	<main class="min-h-screen">
		<header class="bg-stone-900 text-white py-6 px-4 sticky top-0 z-40 shadow-lg">
			<div class="max-w-7xl mx-auto flex justify-between items-center">
				<h1 class="text-2xl md:text-3xl font-bold tracking-wide">Miguel Zapata</h1>
				<nav class="flex items-center gap-6">
					<a href="/en/" class="hover:text-amber-400 transition">Home</a>
					<a href="/en/biography/" class="hover:text-amber-400 transition">Biography</a>
					<a href="/en/artwork/" class="hover:text-amber-400 transition">Artwork</a>
					<a href="/es/obra/dibujo/" class="px-4 py-2 bg-white/10 rounded hover:bg-white/20 transition text-sm">ES</a>
				</nav>
			</div>
		</header>
		<!-- Breadcrumb -->
		<nav class="bg-stone-800 text-stone-300 py-3 px-4">
			<div class="max-w-7xl mx-auto flex items-center gap-2 text-sm">
				<a href="/en/artwork/" class="hover:text-amber-400 transition">← Artwork</a>
				<span class="text-stone-500">/</span>
				<span class="text-white">Drawings</span>
			</div>
		</nav>
		<section class="bg-gradient-to-br from-stone-800 to-stone-900 text-white py-16 px-4">
			<div class="max-w-7xl mx-auto text-center">
				<h2 class="text-4xl md:text-6xl font-bold mb-4">Drawings</h2>
				<p class="text-xl text-stone-300">{images.length} artworks</p>
			</div>
		</section>
		<section class="max-w-7xl mx-auto py-16 px-4">
			<Gallery images={images} columns={3} />
		</section>
		<footer class="bg-stone-900 text-white py-12 px-4">
			<div class="max-w-7xl mx-auto text-center">
				<p class="text-stone-400">&copy; {new Date().getFullYear()} Miguel Zapata. All rights reserved.</p>
			</div>
		</footer>
	</main>
</Layout>
