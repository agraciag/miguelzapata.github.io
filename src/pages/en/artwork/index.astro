---
import Layout from '../../../layouts/Layout.astro';
import Gallery from '../../../components/Gallery.astro';
import { categories } from '../../../data/categories';
import { readdir } from 'fs/promises';

// Get all gallery images
const galleryDir = 'public/images/gallery';
const files = await readdir(galleryDir);

const allImages = files
  .filter(f => f.endsWith('.jpg') && !f.includes('├'))
  .sort()
  .map((filename) => {
    const name = filename.replace('.jpg', '').replace(/-1$/, '');
    return {
      src: `/images/gallery/${filename}`,
      alt: name,
      title: name.replace(/-/g, ' ')
    };
  });

// Categories with data and thumbnail (first image from each category)
const categoryList = [
  { name: 'Engraving', slug: 'engraving', count: categories.grabado.length, thumb: categories.grabado[0] },
  { name: 'Drawings', slug: 'drawings', count: categories.dibujo.length, thumb: categories.dibujo[0] },
  { name: 'Mixed Media', slug: 'mixed-media', count: categories.tecnicaMixta.length, thumb: categories.tecnicaMixta[0] },
  { name: 'Oil Painting', slug: 'oil-painting', count: categories.oleo.length, thumb: categories.oleo[0] },
  { name: 'Sculpture', slug: 'sculpture', count: categories.escultura.length, thumb: categories.escultura[0] },
  { name: 'Collage', slug: 'collage', count: categories.collage.length, thumb: categories.collage[0] },
];
---

<Layout
	title="Miguel Zapata Artwork"
	lang="en"
	description="Complete gallery of Miguel Zapata's artwork. Engravings, oil paintings, sculptures and mixed media."
>
	<main class="min-h-screen">
		<!-- Header / Navigation -->
		<header class="bg-stone-900 text-white py-6 px-4 sticky top-0 z-40 shadow-lg">
			<div class="max-w-7xl mx-auto flex justify-between items-center">
				<h1 class="text-2xl md:text-3xl font-bold tracking-wide">Miguel Zapata</h1>
				<nav class="flex items-center gap-6">
					<a href="/en/" class="hover:text-amber-400 transition">Home</a>
					<a href="/en/biography/" class="hover:text-amber-400 transition">Biography</a>
					<a href="/en/artwork/" class="hover:text-amber-400 transition font-semibold">Artwork</a>
					<a href="/es/obra/" class="px-4 py-2 bg-white/10 rounded hover:bg-white/20 transition text-sm">ES</a>
				</nav>
			</div>
		</header>

		<!-- Page Header -->
		<section class="bg-gradient-to-br from-stone-800 to-stone-900 text-white py-16 px-4">
			<div class="max-w-7xl mx-auto text-center">
				<h2 class="text-4xl md:text-6xl font-bold mb-6">Artwork</h2>
				<p class="text-xl text-stone-300 max-w-3xl mx-auto">
					Explore Miguel Zapata's collection by category
				</p>
			</div>
		</section>

		<!-- Categories Grid -->
		<section class="max-w-7xl mx-auto py-16 px-4">
			<div class="grid grid-cols-2 md:grid-cols-3 gap-6">
				{categoryList.map((cat) => (
					<a
						href={`/en/artwork/${cat.slug}/`}
						class="group relative rounded-lg overflow-hidden aspect-[4/3] flex items-center justify-center hover:scale-105 transition-transform duration-300"
					>
						<img
							src={`/images/gallery/${cat.thumb}`}
							alt={cat.name}
							class="absolute inset-0 w-full h-full object-cover"
						/>
						<div class="text-center text-white z-10 relative">
							<h3 class="text-2xl md:text-3xl font-bold mb-2 group-hover:text-amber-400 transition drop-shadow-lg">{cat.name}</h3>
							<p class="text-stone-200 drop-shadow-lg">{cat.count} artworks</p>
						</div>
						<div class="absolute inset-0 bg-gradient-to-t from-stone-900/90 via-stone-900/50 to-stone-900/30 group-hover:from-stone-900/80 transition"></div>
					</a>
				))}
			</div>
		</section>

		<!-- Full Gallery Section -->
		<section class="bg-stone-100 py-16 px-4">
			<div class="max-w-7xl mx-auto">
				<h3 class="text-3xl font-bold text-center mb-8">Complete Gallery</h3>
				<p class="text-center text-stone-600 mb-12">
					{allImages.length} artworks in total. Click on any image to view it in detail.
				</p>
				<Gallery images={allImages} columns={3} />
			</div>
		</section>

		<!-- Footer -->
		<footer class="bg-stone-900 text-white py-12 px-4">
			<div class="max-w-7xl mx-auto text-center">
				<p class="text-stone-400">&copy; {new Date().getFullYear()} Miguel Zapata. All rights reserved.</p>
				<p class="text-stone-500 mt-2 text-sm">Website created in memory of the artist</p>
			</div>
		</footer>
	</main>
</Layout>
