---
import Layout from '../../../layouts/Layout.astro';
import Gallery from '../../../components/Gallery.astro';
import { readdir } from 'fs/promises';

// Get all gallery images
const galleryDir = 'public/images/gallery';
const files = await readdir(galleryDir);

const allImages = files
  .filter(f => f.endsWith('.jpg') && !f.includes('├'))
  .sort()
  .map((filename) => {
    const name = filename.replace('.jpg', '').replace(/-1$/, '');
    return {
      src: `/images/gallery/${filename}`,
      alt: name,
      title: name.replace(/-/g, ' ')
    };
  });
---

<Layout
	title="Miguel Zapata Artwork"
	lang="en"
	description="Complete gallery of Miguel Zapata's artwork. Engravings, oil paintings, sculptures and mixed media."
>
	<main class="min-h-screen">
		<!-- Header / Navigation -->
		<header class="bg-stone-900 text-white py-6 px-4 sticky top-0 z-40 shadow-lg">
			<div class="max-w-7xl mx-auto flex justify-between items-center">
				<h1 class="text-2xl md:text-3xl font-bold tracking-wide">Miguel Zapata</h1>
				<nav class="flex items-center gap-6">
					<a href="/en/" class="hover:text-amber-400 transition">Home</a>
					<a href="/en/biography/" class="hover:text-amber-400 transition">Biography</a>
					<a href="/en/artwork/" class="hover:text-amber-400 transition font-semibold">Artwork</a>
					<a href="/es/obra/" class="px-4 py-2 bg-white/10 rounded hover:bg-white/20 transition text-sm">ES</a>
				</nav>
			</div>
		</header>

		<!-- Page Header -->
		<section class="bg-gradient-to-br from-stone-800 to-stone-900 text-white py-20 px-4">
			<div class="max-w-7xl mx-auto text-center">
				<h2 class="text-4xl md:text-6xl font-bold mb-6">Complete Gallery</h2>
				<p class="text-xl text-stone-300 max-w-3xl mx-auto">
					Collection of {allImages.length} works by Miguel Zapata.
					Click on any image to view it in detail.
				</p>
			</div>
		</section>

		<!-- Gallery Section -->
		<section class="max-w-7xl mx-auto py-16 px-4">
			<Gallery images={allImages} columns={3} />
		</section>

		<!-- Instructions -->
		<section class="bg-stone-100 py-12 px-4">
			<div class="max-w-4xl mx-auto text-center">
				<h4 class="text-2xl font-bold mb-4">Navigation</h4>
				<div class="grid md:grid-cols-3 gap-6 mt-8">
					<div class="bg-white p-6 rounded-lg shadow">
						<div class="text-4xl mb-3">🖱️</div>
						<h5 class="font-bold mb-2">Click on image</h5>
						<p class="text-sm text-stone-600">Opens image in fullscreen</p>
					</div>
					<div class="bg-white p-6 rounded-lg shadow">
						<div class="text-4xl mb-3">⌨️</div>
						<h5 class="font-bold mb-2">Arrow keys ← →</h5>
						<p class="text-sm text-stone-600">Navigate between images</p>
					</div>
					<div class="bg-white p-6 rounded-lg shadow">
						<div class="text-4xl mb-3">✕</div>
						<h5 class="font-bold mb-2">ESC or X</h5>
						<p class="text-sm text-stone-600">Closes the enlarged view</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Footer -->
		<footer class="bg-stone-900 text-white py-12 px-4">
			<div class="max-w-7xl mx-auto text-center">
				<p class="text-stone-400">&copy; {new Date().getFullYear()} Miguel Zapata. All rights reserved.</p>
				<p class="text-stone-500 mt-2 text-sm">Website created in memory of the artist</p>
			</div>
		</footer>
	</main>
</Layout>
