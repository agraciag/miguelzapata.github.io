---
import '../styles/global.css';

interface Props {
	title: string;
	lang?: 'es' | 'en';
	description?: string;
}

const {
	title,
	lang = 'es',
	description = 'Miguel Zapata - Escultor, pintor y grabador. Obra completa que fusiona tradición renacentista con expresionismo moderno.'
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<meta name="keywords" content="Miguel Zapata, escultor, pintor, grabador, arte, renacimiento, expresionismo" />
		<meta name="author" content="Miguel Zapata" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-stone-50 text-stone-900 antialiased selection:bg-amber-200 selection:text-amber-900">
		<slot />
	</body>
</html>
